APP_NAME="Merza CRM"
FSSAI_LICENSE_NUMBER=
STORE_OPERATOR_NAME=
APP_ENV=production
WHATSAPP_OTP_TEMPLATE_NAME=merza_otp
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=merza_crm
DB_USERNAME=merza
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Cloudflare R2 — image / media storage
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=merza-media
CLOUDFLARE_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Configure an R2 custom domain such as https://media.yourdomain.com before switching production URLs.
CLOUDFLARE_R2_URL=
CLOUDFLARE_R2_PUBLIC_URL=
MEDIA_DISK=r2

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Active AI provider for WhatsApp auto-reply, Meta Lead follow-ups, and
# admin AI-draft buttons. One of: groq | openai | anthropic
AI_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

SARVAM_API_KEY=

META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Meta Dataset / Pixel and Conversions API. The Dataset ID is public; keep the
# CAPI token in .env or a production secret manager, never in Vite or Git.
META_TRACKING_ENABLED=true
META_DATASET_ID=2128624118065839
META_CONVERSIONS_API_ENABLED=true
META_CONVERSIONS_API_ACCESS_TOKEN=EAATZBZCsYOe60BS5icJVYngK1QKUZAZC6a19BEIQ3KhIP5sUb5ATeuW3mIvJrJuQihVGECAoeCYazthBieq9ZBgEqLwP3lSQShhBIZATzuaRDk8k4N7BzXRudt3bwcCLp02mxVsns2zzPCZBKIpuZBL09LZBzbcZBKzlXC4jlz07YmA5Nz2X3RgC9JKZBcLI0UjGQZDZD
# Keep this on a currently supported Meta Graph API version.
META_GRAPH_API_VERSION=v26.0
# Set temporarily while using Events Manager > Test Events, then remove it.
META_TEST_EVENT_CODE=
# Keep true unless your legal basis allows tracking before explicit consent.
META_REQUIRE_CONSENT=true

# SabPaisa PG 3.0 — 'manual' (default) keeps the UPI-QR + screenshot flow;
# 'sabpaisa' switches checkout to the hosted SabPaisa gateway below.
PAYMENT_GATEWAY=manual
SABPAISA_API_KEY=
SABPAISA_SECRET_KEY=
SABPAISA_WEBHOOK_SECRET=
SABPAISA_MERCHANT_ID=
SABPAISA_BASE_URL=https://staging-sb-merchant-api.sabpaisa.in
SABPAISA_FALLBACK_EMAIL=

VITE_APP_NAME="${APP_NAME}"
